                    "preferredDataType": "string",
                    "value": "[\n  {\n    \"children\": [\n      {\n        \"text\": \"\"\n      },\n      {\n        \"text\": \"\"\n      },\n      {\n        \"type\": \"link\",\n        \"src\": \"auth.svg\",\n        \"url\": \"jwt\",\n        \"data\": \"{{global.parameters.jwt}}\",\n        \"tooltip\": \"{{global.parameters.jwt}}\",\n        \"children\": [\n          {\n            \"text\": \"jwt\"\n          }\n        ]\n      },\n      {\n        \"text\": \"\"\n      }\n    ]\n  }\n]"
                  }
                ]
              },
              "code": {
                "value": "module.exports = async ({ params }) => {\n  const jwtString = params.jwt;\n\n  // Decode JWT\n  const { payload } = decodeJWT(jwtString);\n  \n  // Check if it's a session-revoked event\n  const eventType = getEventType(payload);\n  \n  if (eventType !== 'https://schemas.openid.net/secevent/caep/event-type/session-revoked') {\n    throw new Error(`Unsupported event type: ${eventType}`);\n  }\n  \n  // Extract username\n  const username = extractUsername(payload);\n  \n  return { jwt: params.jwt, username: username };\n};\n\n// Helper Functions\nfunction decodeJWT(jwtString) {\n  const parts = jwtString.split('.');\n  if (parts.length !== 3) {\n    throw new Error('Invalid JWT format');\n  }\n  \n  const decode = (str) => JSON.parse(\n    Buffer.from(str.replace(/-/g, '+').replace(/_/g, '/'), 'base64').toString()\n  );\n  \n  return {\n    header: decode(parts[0]),\n    payload: decode(parts[1]),\n    parts: parts\n  };\n}\n\nfunction getEventType(payload) {\n  // CAEP events are in the \"events\" object\n  // Example: { \"events\": { \"https://schemas.openid.net/.../session-revoked\": {...} } }\n  \n  if (!payload.events || typeof payload.events !== 'object') {\n    throw new Error('No events found in JWT payload');\n  }\n  \n  const eventTypes = Object.keys(payload.events);\n  \n  if (eventTypes.length === 0) {\n    throw new Error('Events object is empty');\n  }\n  \n  // Return the first (and typically only) event type\n  return eventTypes[0];\n}\n\nfunction extractUsername(payload) {\n  const fullUsername = payload.sub_id?.username?.id;\n  \n  if (!fullUsername) {\n    throw new Error('Username not found in JWT');\n  }\n  \n  // Strip domain prefix (e.g., \"twosense-dev\\jbergeron\" → \"jbergeron\")\n  // Handle both backslash (Windows) and forward slash formats\n  const username = fullUsername.split(/[\\\\\\/]/).pop();\n  \n  return username;\n}"
              },
              "nodeTitle": {
                "value": "Extract username from JWT"
              },
